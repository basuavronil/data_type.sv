module associative_array;
  bit [15:0] a [int];
  initial begin
    a [100] = 10;
    a [200] = 20;
    a [300] = 30;
    a [400] = 40;
    a [500] = 50;
    $display ("%0p",a);
    //array element locator 
    $display (" %0p",a.find(x) with ( x > 10));
    $display ("%0p", a.find_first(x) with (x > 10));
    $display ("%0p",a.find_last(x) with (x > 10));
    //ARRAY INDEX LOCATOR 
    $display ("%0p", a.find_index(x) with (x>10));
    $display (" %0p", a.find_first_index(x) with (x>10));
    $display ("%0p", a.find_last_index(x) with (x>10));
    //Uniq
    $display ("%0p", a.unique());
    //sort
    a.sort();
    $display ("%0p", a);
    a.rsort();
    $display("%0p", a);
    a.shuffle();
    $display ("%0p",a);
    //reduction 
    $display ("%d",a.sum());
    $display ("%b", a.or());
    $display ("%b", a.and());
    //min and max
    $display ("%0p", a.min());
    $display ("%0p", a.max());
    //
    $display(" %0p ", a.find(x) with (x%2 == 0));
    
  end
endmodule
